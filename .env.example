# Mesa 25 — copie para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------
# Modo de operacao: PAPER | PILOTO | REAL
# REAL exige aprovacao manual por ordem, alem do Guardiao.
MESA_MODE=PAPER

# Capital de referencia em BRL (centavos evitados: use decimal simples)
MESA_CAPITAL_BRL=10000

# Chave da corretora. Regras nao negociaveis:
#  - criada por VOCE no painel da corretora
#  - SEM permissao de saque/transferencia
#  - de preferencia do ambiente sandbox/paper
# O sistema recusa iniciar se detectar escopo de saque na chave.
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_BASE_URL=
BROKER_SANDBOX=true

# Fonte secundaria de precos, usada so para conferencia de divergencia
MARKET_DATA_2_URL=
MARKET_DATA_2_KEY=

# Alertas
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# Banco
DATABASE_URL=postgres://localhost:5432/mesa25
